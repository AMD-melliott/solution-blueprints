# Dev-only: where `npm run dev` proxies /analyze and /sys/health.
#
# Copy this file to `.env.local` and adjust as needed:
#     cp .env.example .env.local
#
# Default (no .env.local needed) points at :8003, which is both the mock
# orchestrator AND the real orchestrator's port — so the default "just works"
# whether you run the mock or the real backend on localhost:8003.
#
# To proxy to a real orchestrator on another host:
#     VITE_PROXY_TARGET=http://some-host:8003

VITE_PROXY_TARGET=http://localhost:8003
