# LLM
LLM_MODEL=google/medgemma-27b-it
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Pipeline thresholds
ENTITY_SIMILARITY_THRESHOLD=0.85   # cosine sim to merge entity clusters
DIAGNOSIS_MIN_CONFIDENCE=0.05      # drop diagnoses below this

# Text preprocessing
EXPAND_ABBREVIATIONS=true

# Observability
DEBUG_PIPELINE=false                # set true to log intermediate outputs
