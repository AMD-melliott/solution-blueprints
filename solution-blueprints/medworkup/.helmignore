# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.

.git/
.github/
.claude/

# Application source — not needed by Helm
services/
scripts/
artifacts/
# Docs and config files — not Helm chart artifacts
docs/
Makefile
docker-compose.yml
.env
.env.*
.env.example

# Python environments and caches
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Large model/data files (prevent >5MB limit errors)
*.dat
*.pkl
*.pickle
*.bin
*.pt
*.pth
*.onnx
*.gguf
*.safetensors
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz

# Cache directories
.cache/
models/
data/
downloads/

# Editor and OS files
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
