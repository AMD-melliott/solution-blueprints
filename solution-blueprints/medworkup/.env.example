# ─────────────────────────────────────────────────────────────────────────────
# HC-1 · Environment Configuration
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# This single file is used by both docker compose and the scripts/ tooling.
# .env is gitignored — this file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# HuggingFace token for MedGemma model download
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# ── SCRIPTS ───────────────────────────────────────────────────────────────────
# Used by scripts/download_medcat_model.sh to fetch MedCAT model artifacts.
# Run: bash scripts/download_medcat_model.sh
#
# Which model to download (can be overridden with a CLI arg to the script):
#   umls_small   UMLS subset — disorders, symptoms, medications (~1 GB) [recommended]
#   umls_full    Full UMLS, 4M+ concepts (~5 GB)
#   snomed_int   SNOMED International, trained on MIMIC-III (~2 GB)
#   snomed_uk    SNOMED UK v2 2025, UMLS 2024AA, trained on MIMIC-IV (~2 GB)
#   snomed_mimic SNOMED International v2 2025, trained on MIMIC-IV (~2 GB)
MEDCAT_MODEL=snomed_mimic

# ── KCL LICENCE ───────────────────────────────────────────────────────────────
# All models are downloaded via the KCL licence portal.
# Register and obtain your licence key at: https://medcat.sites.er.kcl.ac.uk
#
# The download script uses a two-step auth flow:
#   1. GET  /auth-callback-api?key=UMLS_API_KEY  → obtains a csrftoken
#   2. POST /download-model (form payload)              → streams the model file
UMLS_API_KEY=

# Personal details submitted in the KCL download form (all required)
MEDCAT_FIRST_NAME=
MEDCAT_LAST_NAME=
MEDCAT_EMAIL=
MEDCAT_AFFILIATION=
MEDCAT_USE_CASE=

# Optional form field (leave blank if not applicable)
MEDCAT_FUNDER=

# ── MEDCAT SERVICE ────────────────────────────────────────────────────────────
# MEDCAT_MODEL_PACK_PATH is written automatically by scripts/download_medcat_model.sh
# after a successful download. You can also set it manually.
#
# Option A — Model pack (recommended, takes precedence over individual files):
#   Container-side path — must start with /cat/models/
MEDCAT_MODEL_PACK_PATH=

# Option B — Individual files (fallback when model pack is not set):
MEDCAT_CDB_PATH=
MEDCAT_VOCAB_PATH=
MEDCAT_META_PATH_LIST=             # colon-separated list for multiple MetaCAT models

MEDCAT_PORT=8004
MEDCAT_MODEL_NAME=MedCAT
MEDCAT_SERVER_WORKERS=1
MEDCAT_WORKER_TIMEOUT=300
MEDCAT_MAX_REQUESTS=1000
MEDCAT_MAX_REQUESTS_JITTER=50
MEDCAT_BULK_NPROC=8
MEDCAT_SHM_SIZE=8g                 # ≥8g required when MEDCAT_BULK_NPROC > 1; use 1g for single-worker
MEDCAT_ENABLE_METRICS=false
MEDCAT_ENABLE_DEMO_UI=false
MEDCAT_DEID_MODE=false

# ── PORTS ─────────────────────────────────────────────────────────────────────
UI_PORT=8080                       # Browser entry point: http://localhost:8080
ORCHESTRATOR_PORT=8003             # Direct API access (debug): http://localhost:8003/docs
NER_PORT=8001
EMBEDDING_PORT=8002
LLM_PORT=8000

# ── LLM PARAMETERS ────────────────────────────────────────────────────────────
LLM_MODEL=google/medgemma-27b-it
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ── PIPELINE THRESHOLDS ───────────────────────────────────────────────────────
ENTITY_SIMILARITY_THRESHOLD=0.85   # cosine sim for entity cluster merging (0-1)
DIAGNOSIS_MIN_CONFIDENCE=0.05      # drop diagnoses below this confidence

# ── TEXT PREPROCESSING ────────────────────────────────────────────────────────
EXPAND_ABBREVIATIONS=true

# ── CPU THREAD LIMITS ──────────────────────────────────────────────────────────
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# ── ML MODEL CONFIGURATION ────────────────────────────────────────────────────
# NER Service — leave NER_ONNX_PATH unset (default) to auto-download from HuggingFace.
# Set to a local artifact directory produced by GLiNER.save_pretrained() to use ONNX mode.
NER_ONNX_PATH=
NER_HF_MODEL_ID=Ihor/gliner-biomed-large-v1.0

# Embedding Service — leave EMBEDDING_ONNX_PATH unset (default) to auto-download from HuggingFace.
EMBEDDING_ONNX_PATH=
EMBEDDING_HF_MODEL_ID=cambridgeltl/SapBERT-from-PubMedBERT-fulltext

# Inference device for HuggingFace mode: cpu | cuda | auto
HF_DEVICE=cpu

# ── OBSERVABILITY ─────────────────────────────────────────────────────────────
LOG_LEVEL=info                     # debug | info | warning | error
DEBUG_PIPELINE=false
